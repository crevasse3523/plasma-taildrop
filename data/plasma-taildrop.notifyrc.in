[Global]
IconName=network-vpn
Comment=Send via Tailscale
DesktopEntry=@HELPER_DESKTOP_ID@

[Event/transferFinished]
Name=Files sent
Comment=All shared files reached the device
Action=Popup

[Event/transferFailed]
Name=Sending failed
Comment=Some shared files were not sent
Action=Popup
